<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dripclient.wireforge"
    platformBuildVersionCode="35"
    platformBuildVersionName="15"
    android:versionCode="27"
    android:versionName="3.6"
    android:compileSdkVersion="35"
    android:compileSdkVersionCodename="15">
    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="33" />
    <queries>
        <package
            android:name="com.dts.freefiremax" />
    </queries>
    <!-- Have full internet access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- View network connections -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Run foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- This app can appear on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Allows an app to query all installed packages (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application
        android:theme="@7f060000"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:name="com.dripclient.wireforge.ProxyApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:appComponentFactory="com.dripclient.wireforge.ProxyComponentFactory">
        <activity
            android:name="com.shizukuservice.ShizukuProvider"
            android:exported="true">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.shizukuservice.ShizukuConnectionResolver"
            android:exported="false" />
        <activity
            android:name="com.shizukuservice.ShizukuConnector"
            android:exported="false"
            android:launchMode="singleTop" />
        <service
            android:name="com.shizukuservice.ShizukuConnection"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action
                    android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name="com.shizukuservice.ShizukuConnectivity"
            android:exported="false" />
    </application>
</manifest>
